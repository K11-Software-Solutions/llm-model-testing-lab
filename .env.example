# Environment variables used by this repo. Set them in your shell; nothing here is required.
# No API keys are needed anywhere in this repo: models run locally.

# Which open-weights model to evaluate (Hugging Face model id)
MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
# Promptfoo provider variant: fp32 | int8 | int4 | random
MODEL_VARIANT=fp32

# Optional: a Hugging Face token raises download rate limits (not required for public models)
# HF_TOKEN=

# Quieter logs
HF_HUB_DISABLE_PROGRESS_BARS=1
TRANSFORMERS_VERBOSITY=error
